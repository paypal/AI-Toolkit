{
  "name": "paypal",
  "version": "1.2.0",
  "private": true,
  "description": "PayPal development plugin for Claude Code, Codex, Cursor, and other AI coding agents — integrate payments, subscriptions, invoices, disputes, and more using PayPal's APIs and MCP server",
  "author": {
    "name": "PayPal",
    "url": "https://developer.paypal.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paypal/AI-Toolkit.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "paypal",
    "payments",
    "checkout",
    "subscriptions",
    "invoices",
    "disputes",
    "mcp",
    "commerce"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\"",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write",
      "markdownlint"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.9.6"
  }
}
